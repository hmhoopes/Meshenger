        <mxCell id="wXaiTVUpDfuw-hldFNOd-21" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="server" vertex="1">
          <mxGeometry height="60" width="120" x="440" y="220" as="geometry" />
        </mxCell>
        <mxCell id="wXaiTVUpDfuw-hldFNOd-22" edge="1" parent="1" source="wXaiTVUpDfuw-hldFNOd-21" style="endArrow=classic;startArrow=classic;html=1;rounded=0;" target="wXaiTVUpDfuw-hldFNOd-19" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points" />
            <mxPoint x="510" y="180" as="sourcePoint" />
            <mxPoint x="510" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="wXaiTVUpDfuw-hldFNOd-23" parent="1" style="text;html=1;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;horizontal=1;whiteSpace=wrap;" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Web App&lt;/font&gt;&lt;/b&gt;&lt;div&gt;Contains:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;current name&lt;/li&gt;&lt;li&gt;current public / private key pair&lt;/li&gt;&lt;li&gt;list of peers, where each entry contains&lt;/li&gt;&lt;ul&gt;&lt;li&gt;peer name&lt;/li&gt;&lt;li&gt;peer pub key&lt;/li&gt;&lt;li&gt;status&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;list of chats, where each entry contains&lt;/li&gt;&lt;ul&gt;&lt;li&gt;list of participants&lt;/li&gt;&lt;li&gt;messages&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;Protocols / Flows:&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Connect to device&lt;/li&gt;&lt;ul&gt;&lt;li&gt;uses existing BLE protocol to pair to device&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;async Sign in&lt;/li&gt;&lt;ul&gt;&lt;li&gt;provide name, password&lt;/li&gt;&lt;li&gt;will use password with KDF to generate pub priv key&lt;/li&gt;&lt;li&gt;message server with name, pub key&lt;/li&gt;&lt;ul&gt;&lt;li&gt;fail if message send fails (&quot;unreachable&quot;)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;if timeout: fail (&quot;unreachable&quot;)&lt;/li&gt;&lt;li&gt;else if &#39;s&#39; before timeout:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;reject sign on if check fails, otherwise accept and enable message sending&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;async Register&lt;/li&gt;&lt;ul&gt;&lt;li&gt;provide name, password&lt;/li&gt;&lt;li&gt;use KDF to gen pub priv from password&lt;/li&gt;&lt;li&gt;message server&lt;/li&gt;&lt;ul&gt;&lt;li&gt;fail if message send fails (&quot;unreachable&quot;)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;if timeout: fail (&quot;unreachable&quot;)&lt;/li&gt;&lt;li&gt;else if &#39;r&#39; before timeout:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;reject if replies with fail (&quot;registration not accepted&quot;), otherwise accept and enable message sending&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;sync Sending (only available if connected and signed in or registered)&lt;/li&gt;&lt;ul&gt;&lt;li&gt;obtain targets, message from user&lt;/li&gt;&lt;li&gt;format header with targets&lt;/li&gt;&lt;li&gt;split message up into one message chunks&lt;/li&gt;&lt;li&gt;for each target&lt;/li&gt;&lt;ul&gt;&lt;li&gt;encrypt body with shared secret from target&lt;/li&gt;&lt;li&gt;use pager to send to target with combined header and enc body&lt;/li&gt;&lt;li&gt;user pager response to mark with ack or unack or failed (mark for each user)&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;sync Receiving (wouldn&#39;t ever receive unless signed in or registered)&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;obtain sender, message from pager&amp;nbsp;&lt;/span&gt;RCV_MSG&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;get header, enc body from message&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;decrypt with sender shared secret&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;add to corresponding chat from header targets, mark with sender&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sync GetList (only available if connected and signed in/registered)&lt;/li&gt;&lt;ul&gt;&lt;li&gt;send message to server asking for list&lt;/li&gt;&lt;li&gt;server will reply with chunks of list, slowly add to them when receiving those messages from device&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sync GetMessages (only available if connected and signed in / registered)&lt;/li&gt;&lt;ul&gt;&lt;li&gt;send message to server asking for messages&lt;/li&gt;&lt;li&gt;server will reply with messages&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;Heartbeat&lt;/li&gt;&lt;ul&gt;&lt;li&gt;respond with name and pub key&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;ReceiveMessage from Pager&lt;/li&gt;&lt;ul&gt;&lt;li&gt;sort into responses by indicator and call appropriate one&lt;/li&gt;&lt;li&gt;&#39;m&#39; -&amp;gt; Receiving&lt;/li&gt;&lt;li&gt;&#39;s&#39; -&amp;gt; sign in&lt;/li&gt;&lt;li&gt;&#39;r&#39; -&amp;gt; register&lt;/li&gt;&lt;li&gt;&#39;l&#39; -&amp;gt; add to list&lt;/li&gt;&lt;li&gt;&#39;g&#39; -&amp;gt; receiving (shouldn&#39;t receive message with this indicator)&lt;/li&gt;&lt;li&gt;&#39;h&#39; -&amp;gt; heartbeat&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1230" width="320" y="320" as="geometry" />
        </mxCell>
        <mxCell id="wXaiTVUpDfuw-hldFNOd-24" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;horizontal=1;perimeterSpacing=1;" value="&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Pager&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Contains:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;current name&lt;/li&gt;&lt;li&gt;Qeue of messages seen, where each entry &lt;br&gt;contains&lt;/li&gt;&lt;ul&gt;&lt;li&gt;sender name&lt;/li&gt;&lt;li&gt;message id&lt;/li&gt;&lt;li&gt;message ack id&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;global message id counter&lt;/li&gt;&lt;li&gt;waiting for ack flag&lt;/li&gt;&lt;li&gt;obtaining ble message flag&lt;/li&gt;&lt;li&gt;current ble message&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;Protocols / Flows:&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;BLE pairing&lt;/li&gt;&lt;ul&gt;&lt;li&gt;accept unless already paired&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;BLE disconnect&lt;/li&gt;&lt;ul&gt;&lt;li&gt;clear cur name, waiting for ack flag, obtaining ble message flag, and current ble message&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;BLE set name&lt;/li&gt;&lt;ul&gt;&lt;li&gt;sets the current name to be the 12 char name&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;BLE Message Compiling&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;set obtaining ble message&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;set target from first 12 chars&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;add messages from ble to current ble message until stop stream indicator seen&lt;/li&gt;&lt;li&gt;Send message to target&lt;/li&gt;&lt;li&gt;send app what happened to message (failed, sent to node, sent to server)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;SEND_WAIT&lt;/li&gt;&lt;ul&gt;&lt;li&gt;use provided message&lt;/li&gt;&lt;li&gt;set id to global id++&lt;/li&gt;&lt;li&gt;set unack to true&lt;/li&gt;&lt;li&gt;do _ while unack &amp;amp; i &amp;lt; 5:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;send with ack id i&lt;/li&gt;&lt;li&gt;delay 100*i&lt;/li&gt;&lt;li&gt;increment i&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;if unack and !message.backup, call SEND_WAIT with message.backup set to true&amp;nbsp;&lt;/li&gt;&lt;li&gt;return enum with fields (Failed, SentToNode, SentToServer)&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;HOP&lt;/li&gt;&lt;ul&gt;&lt;li&gt;if msg target, id, ack id is in queue, return&lt;/li&gt;&lt;li&gt;else, add to end of queue&lt;/li&gt;&lt;li&gt;if queue len &amp;gt; MAX_QUEUE_LEN, drop front&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;HANDLE&lt;/li&gt;&lt;ul&gt;&lt;li&gt;if name != msg.target:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Call HOP, exit&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;send ack&lt;/li&gt;&lt;li&gt;use send to app to send to app&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="830" width="320" x="360" y="320" as="geometry" />
        </mxCell>
        <mxCell id="wXaiTVUpDfuw-hldFNOd-26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;horizontal=1;labelBorderColor=none;perimeterSpacing=1;" value="&lt;div&gt;&lt;span style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Server&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Contains:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;list of user names, statuses, and public keys&lt;/li&gt;&lt;li&gt;database of previous messages&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;Protocols / Flows:&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;register&lt;/li&gt;&lt;ul&gt;&lt;li&gt;check if name isn&#39;t in list and pub key isn&#39;t in list&lt;/li&gt;&lt;li&gt;if so, send back success&lt;/li&gt;&lt;li&gt;if not, send back failure&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;sign in&lt;/li&gt;&lt;ul&gt;&lt;li&gt;check if name is in list, pub key matches, and not active&lt;/li&gt;&lt;li&gt;if so, send back success&lt;/li&gt;&lt;li&gt;if not, send back failure&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;GetList&lt;/li&gt;&lt;ul&gt;&lt;li&gt;iterate through list, splitting into chunks that will fit in one message&lt;/li&gt;&lt;li&gt;send them in format with 32 bit num (min 0, max 18 given message format + num) following &#39;l&#39; indicating how many list entries are present&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;HeartBeat&lt;/li&gt;&lt;ul&gt;&lt;li&gt;iterate through list&lt;/li&gt;&lt;ul&gt;&lt;li&gt;send message with indicator h, rest empty&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;GetMessages&lt;/li&gt;&lt;ul&gt;&lt;li&gt;calls get list to ensure they have list&lt;/li&gt;&lt;li&gt;opens database, sends every message one by one&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;ReceiveMessage from Pager&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&#39;m&#39; -&amp;gt; add to list of messages for name&lt;/li&gt;&lt;li&gt;&#39;h&#39; -&amp;gt; shouldn&#39;t be received&lt;/li&gt;&lt;li&gt;&#39;s&#39; -&amp;gt; do sign in func&lt;/li&gt;&lt;li&gt;&#39;r&#39; -&amp;gt; do register func&lt;/li&gt;&lt;li&gt;&#39;l&#39; -&amp;gt; do get list func&lt;/li&gt;&lt;li&gt;&#39;g&#39; -&amp;gt; do get messages func&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="600" width="320" x="720" y="320" as="geometry" />
        </mxCell>
        <mxCell id="wXaiTVUpDfuw-hldFNOd-27" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;labelPosition=center;verticalLabelPosition=middle;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;Edge Cases that need handling in future:&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;if a user is signed in on multiple at once&lt;/li&gt;&lt;li&gt;malicious user floods acks (AUTHING PAGERS)&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="350" x="1080" y="320" as="geometry" />
        </mxCell>
        <mxCell id="wXaiTVUpDfuw-hldFNOd-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;labelPosition=center;verticalLabelPosition=middle;" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Concepts:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;name: 16 character unique user name&lt;/span&gt;&lt;/li&gt;&lt;li&gt;asymmetric alg: ED25519&lt;/li&gt;&lt;ul&gt;&lt;li&gt;32 bytes for pub key&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;message: message sent between pagers&lt;/li&gt;&lt;ul&gt;&lt;li&gt;contains:&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;target name,&amp;nbsp;&lt;/li&gt;&lt;li&gt;source name,&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;backup to server&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;id,&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;ack id,&amp;nbsp;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&amp;gt;=0 for acks, -1 if not an ack&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;message indicator:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;first char of message, indicates what type it is&lt;/li&gt;&lt;li&gt;types:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&#39;m&#39;-&amp;gt; normal message&lt;/li&gt;&lt;li&gt;&#39;h&#39; -&amp;gt; heartbeat&lt;/li&gt;&lt;li&gt;&#39;s&#39; -&amp;gt; sign in&lt;/li&gt;&lt;li&gt;&#39;r&#39; -&amp;gt; register&lt;/li&gt;&lt;li&gt;&#39;l&#39; -&amp;gt; get list&lt;/li&gt;&lt;li&gt;&#39;g&#39; -&amp;gt; get messages&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;li&gt;message target headers (only in &#39;m&#39;)&lt;/li&gt;&lt;ul&gt;&lt;li&gt;after message indicator, 2-122 chars containing all target reciepients names&lt;/li&gt;&lt;li&gt;limited to 10 names&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="430" width="270" x="1080" y="440" as="geometry" />
        </mxCell>
        <mxCell id="wXaiTVUpDfuw-hldFNOd-62" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Note:&lt;/font&gt;&lt;/b&gt;&lt;div&gt;won&#39;t broadcast but instead will update message hop / routing to work with new paradigm, so some things can be subject to change&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;use names in routing table, keeping message hopping&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="470" x="720" y="960" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
